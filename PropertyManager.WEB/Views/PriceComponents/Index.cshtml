@using PropertyManager.WEB.ViewModels.PriceComponents
@model PriceComponentIndexViewModel

<h2>Price Components</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h4 class="mt-4">Add component</h4>
<form asp-action="Create" method="post" class="row g-2 align-items-end mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Form.Name" class="form-label"></label>
        <input asp-for="Form.Name" class="form-control" />
        <span asp-validation-for="Form.Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <div class="form-check mb-2">
            <input asp-for="Form.IncludeInCommission" class="form-check-input" />
            <label asp-for="Form.IncludeInCommission" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Commission</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Components.Any())
        {
            <tr>
                <td colspan="4" class="text-muted">No price components yet.</td>
            </tr>
        }
        else
        {
            @foreach (var component in Model.Components)
            {
                <tr>
                    <td>@component.Name</td>
                    <td>
                        @if (component.IncludeInCommission)
                        {
                            <span class="badge bg-success">Included</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Excluded</span>
                        }
                    </td>
                    <td>
                        @if (component.IsActive)
                        {
                            <span class="badge bg-primary">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@component.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@component.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Delete this price component?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
