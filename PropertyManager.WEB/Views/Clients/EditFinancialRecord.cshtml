@using PropertyManager.Domain.Models.Enums
@using PropertyManager.WEB.ViewModels.Clients

@model UnitFinancialRecordFormViewModel

<h2>Edit Financial Record</h2>

<form asp-action="EditFinancialRecord" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="UnitId" />
    <input type="hidden" asp-for="FilterSubtypeId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<FinancialRecordType>()" data-record-type></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SubtypeId" class="form-label"></label>
        <select asp-for="SubtypeId" class="form-select" data-subtype-select
                data-selected-id="@Model.SubtypeId"
                data-preserved-id="@(Model.Id > 0 && Model.SubtypeId > 0 ? Model.SubtypeId.ToString() : "")">
            <option value="">Select a subtype</option>
        </select>
        <span asp-validation-for="SubtypeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" type="date" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrencyId" class="form-label"></label>
        <select asp-for="CurrencyId" class="form-select" asp-items="Model.Currencies"></select>
        <span asp-validation-for="CurrencyId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label"></label>
        <input asp-for="Comment" class="form-control" />
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContractorClientId" class="form-label"></label>
        <select asp-for="ContractorClientId" class="form-select" asp-items="Model.Contractors">
            <option value="">None</option>
        </select>
        <div class="form-text">Saved on expenses. The selected client receives the Contractor role.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="UnitFinancialRecords"
       asp-route-clientId="@Model.ClientId"
       asp-route-unitId="@Model.UnitId"
       asp-route-subtypeId="@Model.FilterSubtypeId"
       class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FinancialRecordSubtypeScript" model="Model.SubtypeOptions" />
}
