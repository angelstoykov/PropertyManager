@using PropertyManager.Domain.Models.Enums
@using PropertyManager.WEB.ViewModels.Clients

@model UnitFinancialRecordsViewModel

<h2>Financial Records</h2>

<div class="mb-3">
    <strong>Client:</strong> @Model.ClientDisplayName<br />
    <strong>Unit:</strong> @Model.UnitName - @Model.UnitAddress - @Model.UnitNumber
</div>

<h4 class="mt-4">Add Record</h4>
<form asp-action="AddFinancialRecord" method="post" class="row g-2 align-items-end mb-4">
    <input type="hidden" asp-for="FinancialRecord.ClientId" />
    <input type="hidden" asp-for="FinancialRecord.UnitId" />
    <input type="hidden" asp-for="FinancialRecord.FilterSubtypeId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-2">
        <label asp-for="FinancialRecord.Type" class="form-label"></label>
        <select asp-for="FinancialRecord.Type" class="form-select" asp-items="Html.GetEnumSelectList<FinancialRecordType>()" data-record-type></select>
        <span asp-validation-for="FinancialRecord.Type" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="FinancialRecord.SubtypeId" class="form-label"></label>
        <select asp-for="FinancialRecord.SubtypeId" class="form-select" data-subtype-select
                data-selected-id="@Model.FinancialRecord.SubtypeId"
                data-preserved-id="">
            <option value="">Select a subtype</option>
        </select>
        <span asp-validation-for="FinancialRecord.SubtypeId" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="FinancialRecord.Date" class="form-label"></label>
        <input asp-for="FinancialRecord.Date" class="form-control" type="date" />
        <span asp-validation-for="FinancialRecord.Date" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="FinancialRecord.Amount" class="form-label"></label>
        <input asp-for="FinancialRecord.Amount" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="FinancialRecord.Amount" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="FinancialRecord.CurrencyId" class="form-label"></label>
        <select asp-for="FinancialRecord.CurrencyId" class="form-select" asp-items="Model.Currencies"></select>
        <span asp-validation-for="FinancialRecord.CurrencyId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FinancialRecord.Comment" class="form-label"></label>
        <input asp-for="FinancialRecord.Comment" class="form-control" />
        <span asp-validation-for="FinancialRecord.Comment" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FinancialRecord.ContractorClientId" class="form-label"></label>
        <select asp-for="FinancialRecord.ContractorClientId" class="form-select" asp-items="Model.FinancialRecord.Contractors">
            <option value="">None</option>
        </select>
        <div class="form-text">Saved on expenses. The selected client receives the Contractor role.</div>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<form asp-action="UnitFinancialRecords" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="clientId" value="@Model.ClientId" />
    <input type="hidden" name="unitId" value="@Model.UnitId" />
    <div class="col-md-4">
        <label class="form-label" for="subtypeId">Subtype</label>
        <select id="subtypeId" name="subtypeId" class="form-select" onchange="this.form.submit()">
            <option value="">All subtypes</option>
            <optgroup label="Income">
                @foreach (var subtype in Model.FinancialRecord.SubtypeOptions.Where(option => option.Type == (int)FinancialRecordType.Income))
                {
                    <option value="@subtype.Id" selected="@(Model.SelectedSubtypeId == subtype.Id)">
                        @(subtype.IsActive ? subtype.Name : subtype.Name + " (inactive)")
                    </option>
                }
            </optgroup>
            <optgroup label="Expense">
                @foreach (var subtype in Model.FinancialRecord.SubtypeOptions.Where(option => option.Type == (int)FinancialRecordType.Expense))
                {
                    <option value="@subtype.Id" selected="@(Model.SelectedSubtypeId == subtype.Id)">
                        @(subtype.IsActive ? subtype.Name : subtype.Name + " (inactive)")
                    </option>
                }
            </optgroup>
        </select>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Type</th>
            <th>Subtype</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Currency</th>
            <th>Contractor</th>
            <th>Comment</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Records.Any())
        {
            <tr>
                <td colspan="8" class="text-muted">@(Model.SelectedSubtypeId is > 0 ? "No financial records match this subtype." : "No financial records yet.")</td>
            </tr>
        }
        else
        {
            @foreach (var record in Model.Records)
            {
                <tr>
                    <td>
                        @if (record.Type == FinancialRecordType.Income)
                        {
                            <span class="badge bg-success">Income</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Expense</span>
                        }
                    </td>
                    <td>@record.SubtypeName</td>
                    <td>@record.Date.ToString("yyyy-MM-dd")</td>
                    <td>@record.Amount.ToString("N2")</td>
                    <td>@(Model.CurrencySymbols.GetValueOrDefault(record.CurrencyId) ?? record.CurrencySymbol ?? record.CurrencyCode)</td>
                    <td>@(string.IsNullOrWhiteSpace(record.ContractorName) ? "—" : record.ContractorName)</td>
                    <td>@(string.IsNullOrWhiteSpace(record.Comment) ? "—" : record.Comment)</td>
                    <td class="text-nowrap">
                        <a asp-action="EditFinancialRecord"
                           asp-route-clientId="@Model.ClientId"
                           asp-route-unitId="@Model.UnitId"
                           asp-route-id="@record.Id"
                           asp-route-subtypeId="@Model.SelectedSubtypeId"
                           class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeleteFinancialRecord" method="post" class="d-inline">
                            <input type="hidden" name="clientId" value="@Model.ClientId" />
                            <input type="hidden" name="unitId" value="@Model.UnitId" />
                            <input type="hidden" name="id" value="@record.Id" />
                            <input type="hidden" name="subtypeId" value="@Model.SelectedSubtypeId" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Delete this record?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<a asp-action="RentedUnits" asp-route-id="@Model.ClientId" class="btn btn-secondary">Back to Rented Units</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FinancialRecordSubtypeScript" model="Model.FinancialRecord.SubtypeOptions" />
}
