@using PropertyManager.WEB.ViewModels.Units
@model UnitDetailsViewModel

<h2>Unit Details</h2>

<div class="card">
    <div class="card-body">

        <h4>Unit @Model.UnitNumber</h4>

        <p><strong>Property:</strong> @Model.PropertyName</p>
        <p><strong>Area:</strong> @Model.Area m²</p>
        <p><strong>Floor:</strong> @Model.Floor</p>
        <p><strong>Status:</strong> @Model.Status</p>

        <a asp-controller="Units" asp-action="Index" asp-route-propertyId="@Model.PropertyId" class="btn btn-secondary">
            Back to Units
        </a>

    </div>
</div>

<h3 class="mt-4">Price</h3>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Component</th>
            <th>Amount</th>
            <th>Currency</th>
            <th>Commission</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.PriceLines.Any())
        {
            <tr>
                <td colspan="5" class="text-muted">No price components yet.</td>
            </tr>
        }
        else
        {
            @foreach (var line in Model.PriceLines)
            {
                <tr>
                    <td>@line.ComponentName</td>
                    <td>@line.Amount.ToString("N2")</td>
                    <td>@line.CurrencySymbol</td>
                    <td>
                        @if (line.IncludeInCommission)
                        {
                            <span class="badge bg-success">Included</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Excluded</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="EditPrice" asp-route-unitId="@Model.Id" asp-route-id="@line.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeletePrice" method="post" class="d-inline">
                            <input type="hidden" name="unitId" value="@Model.Id" />
                            <input type="hidden" name="id" value="@line.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Remove this price component from the unit?');">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.Totals.Any())
{
    <div class="mb-4">
        @foreach (var total in Model.Totals)
        {
            <p class="mb-1">
                <strong>@total.CurrencySymbol</strong>
                Tenant total: @total.TenantTotal.ToString("N2").
                Commission base: @total.CommissionBase.ToString("N2").
            </p>
        }
    </div>
}

@if (Model.PriceForm.Components.Any())
{
    <h4>Add component</h4>
    <form asp-action="AddPrice" method="post" class="row g-2 align-items-end mb-4">
        <input type="hidden" asp-for="PriceForm.UnitId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-4">
            <label asp-for="PriceForm.PriceComponentId" class="form-label"></label>
            <select asp-for="PriceForm.PriceComponentId" class="form-select" asp-items="Model.PriceForm.Components"></select>
            <span asp-validation-for="PriceForm.PriceComponentId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="PriceForm.Amount" class="form-label"></label>
            <input asp-for="PriceForm.Amount" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="PriceForm.Amount" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PriceForm.CurrencyId" class="form-label"></label>
            <select asp-for="PriceForm.CurrencyId" class="form-select" asp-items="Model.PriceForm.Currencies"></select>
            <span asp-validation-for="PriceForm.CurrencyId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Add</button>
        </div>
    </form>
}
else if (Model.HasActiveCatalogComponents)
{
    <p class="text-muted">Every active price component is already on this unit.</p>
}
else
{
    <p class="text-muted">Add an active price component in the catalog before assigning one to this unit.</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
