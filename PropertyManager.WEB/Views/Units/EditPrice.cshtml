@using PropertyManager.WEB.ViewModels.Units
@model UnitPriceFormViewModel

<h2>Edit Unit Price</h2>

<form asp-action="EditPrice" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UnitId" />
    <input type="hidden" asp-for="PriceComponentId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Component</label>
        <input class="form-control" value="@Model.ComponentName" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Commission</label>
        <input class="form-control" value="@(Model.IncludeInCommission ? "Included" : "Excluded")" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrencyId" class="form-label"></label>
        <select asp-for="CurrencyId" class="form-select" asp-items="Model.Currencies"></select>
        <span asp-validation-for="CurrencyId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.UnitId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
